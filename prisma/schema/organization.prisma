model Organization {
    id         Int      @id @default(autoincrement())
    name       String
    address    String
    phone      String
    created_at DateTime @default(now()) @map("created_at")
    updated_at DateTime @updatedAt @map("updated_at")

    // Relations
    divisions   Division[]
    departments Department[]
    roles       Role[]
    users       User[]
    tasks       Task[]
    task_logs   TaskLog[]
    attendances Attendance[]

    @@map("organizations")
}
