model Organization {
  id          String       @id @default(uuid())
  name        String
  created_at  DateTime     @default(now()) @map("created_at")
  updated_at  DateTime     @updatedAt @map("updated_at")
  address     String
  phone       String?
  attendances Attendance[]
  departments Department[]
  divisions   Division[]
  projects    Project[]
  roles       Role[]
  task_logs   TaskLog[]
  users       User[]
  tasks       Task[]

  @@map("organizations")
}
