model User {
    id              Int      @id @default(autoincrement())
    organization_id Int      @map("organization_id")
    department_id   Int      @map("department_id")
    role_id         Int      @map("role_id")
    name            String
    email           String   @unique
    password        String
    created_at      DateTime @default(now()) @map("created_at")
    updated_at      DateTime @updatedAt @map("updated_at")
    phone_number String
    division_id Int   @map("division_id")


    // Relations
    organization   Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
    department     Department   @relation(fields: [department_id], references: [id], onDelete: Cascade)
    role           Role         @relation(fields: [role_id], references: [id], onDelete: Cascade)
    created_tasks  Task[]       @relation("TaskCreatedBy")
    assigned_tasks Task[]       @relation("TaskAssignedTo")
    task_logs      TaskLog[]
    attendances    Attendance[]
    division Division @relation(fields: [division_id], references: [id], onDelete: Cascade)

    @@index([organization_id])
    @@index([department_id])
    @@index([role_id])
    @@map("users")
}
        