model Organization {
    id              Int @id @default(autoincrement())
    name            String  @db.VarChar(50)
    createdAt       DateTime @default(now()) @map("created_at")
    updateAt        DateTime @updatedAt @map("update_at")
    deletedAt       DateTime? @map("delete_at")

    departments Department[]
    users       User[]
    // divisions   Division[]

    @@map("organizations")
}